{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/goals/scenario.v1.json",
  "title": "Immutable benchmark scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "version", "title", "world", "objective", "allowed_tools", "constraints", "model_budget", "objectives", "penalties", "end_condition", "scoring", "observation", "camera_relevance_hints", "replay_tolerances"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "scenario_id": { "$ref": "#/$defs/identifier" },
    "version": { "$ref": "#/$defs/semantic_version" },
    "title": { "$ref": "#/$defs/public_text" },
    "world": { "$ref": "#/$defs/world" },
    "objective": { "$ref": "#/$defs/objective_text" },
    "allowed_tools": { "$ref": "#/$defs/tools" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "model_budget": { "$ref": "#/$defs/model_budget" },
    "objectives": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/objective" } },
    "penalties": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/penalty" } },
    "end_condition": { "$ref": "#/$defs/end_condition" },
    "scoring": { "$ref": "#/$defs/scoring" },
    "observation": { "$ref": "#/$defs/observation" },
    "camera_relevance_hints": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
    "replay_tolerances": { "$ref": "#/$defs/replay_tolerances" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "semantic_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "public_text": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "objective_text": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": ["starting_save_id", "content_manifest_id", "game_settings_id", "start_date"],
      "properties": {
        "starting_save_id": { "$ref": "#/$defs/identifier" },
        "content_manifest_id": { "$ref": "#/$defs/identifier" },
        "game_settings_id": { "$ref": "#/$defs/identifier" },
        "start_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "tools": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_cash_reserve", "per_project_budget", "maximum_active_projects", "allowed_modes", "allowed_cargo"],
      "properties": {
        "minimum_cash_reserve": { "type": "integer", "minimum": 0 },
        "per_project_budget": { "type": "integer", "minimum": 1 },
        "maximum_active_projects": { "type": "integer", "minimum": 1, "maximum": 16 },
        "allowed_modes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 32 } },
        "allowed_cargo": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "maxLength": 32 } }
      }
    },
    "model_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_calls", "maximum_output_tokens", "maximum_retries"],
      "properties": {
        "maximum_calls": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximum_output_tokens": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximum_retries": { "type": "integer", "minimum": 0, "maximum": 3 }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "metric", "minimum"],
      "properties": {
        "objective_id": { "$ref": "#/$defs/identifier" },
        "metric": { "type": "string", "enum": ["operational_route_count", "cargo_delivered", "operating_profit"] },
        "minimum": { "type": "integer", "minimum": 0 }
      }
    },
    "penalty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "trigger", "points"],
      "properties": {
        "key": { "$ref": "#/$defs/identifier" },
        "trigger": { "type": "string", "enum": ["invalid_decision", "constraint_violation"] },
        "points": { "type": "number", "minimum": 0 }
      }
    },
    "end_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["game_date", "bankruptcy", "goal_completed", "model_budget_exhausted"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_schema_version", "formula_id", "components"],
      "properties": {
        "score_schema_version": { "const": "1.0" },
        "formula_id": { "const": "road-profit-v1" },
        "components": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "$ref": "#/$defs/score_component" } }
      }
    },
    "score_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "metric", "units", "baseline", "cap", "weight", "missing_data_behavior", "penalty_interaction"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*$" },
        "metric": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*$" },
        "units": { "type": "string", "minLength": 1, "maxLength": 80 },
        "baseline": { "type": "number" },
        "cap": { "type": "number" },
        "weight": { "type": "number", "minimum": 0 },
        "missing_data_behavior": { "type": "string", "enum": ["zero", "fail"] },
        "penalty_interaction": { "const": "subtract_after_component_normalization" }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ranking_rule", "maximum_canonical_bytes", "maximum_estimated_tokens"],
      "properties": {
        "ranking_rule": { "const": "population_then_distance" },
        "maximum_canonical_bytes": { "type": "integer", "minimum": 1024, "maximum": 12288 },
        "maximum_estimated_tokens": { "type": "integer", "minimum": 256, "maximum": 8192 }
      }
    },
    "replay_tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash", "operating_profit", "company_value", "cargo_delivered", "active_vehicle_count", "operational_route_count", "infrastructure_investment"],
      "properties": {
        "cash": { "type": "integer", "minimum": 0 },
        "operating_profit": { "type": "integer", "minimum": 0 },
        "company_value": { "type": "integer", "minimum": 0 },
        "cargo_delivered": { "type": "integer", "minimum": 0 },
        "active_vehicle_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "operational_route_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "infrastructure_investment": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
