{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/goals/scenario-publication.v1.json",
  "title": "Published scenario catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "published_scenarios"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "published_scenarios": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "version", "sha256"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/identifier" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
