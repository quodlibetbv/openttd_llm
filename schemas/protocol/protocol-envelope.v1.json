{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/protocol/protocol-envelope.v1.json",
  "title": "Arena protocol envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "message_type",
    "run_id",
    "message_id",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "message_type": {
      "type": "string",
      "enum": [
        "hello",
        "capabilities",
        "heartbeat",
        "pause_request",
        "pause_result",
        "resume_request",
        "resume_result",
        "snapshot_request",
        "snapshot_result",
        "action_request",
        "action_progress",
        "action_result",
        "camera_request",
        "camera_result",
        "checkpoint_request",
        "checkpoint_result",
        "finalize_request",
        "finalize_result",
        "error"
      ]
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "message_id": {
      "$ref": "#/$defs/identifier"
    },
    "correlation_id": {
      "$ref": "#/$defs/identifier"
    },
    "idempotency_key": {
      "$ref": "#/$defs/identifier"
    },
    "payload": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": true
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
