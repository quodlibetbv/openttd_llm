{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/runs/bridge-result.v1.json",
  "title": "Arena AdminPort bridge smoke result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "completed_utc",
    "succeeded",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "completed_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 64
    },
    "succeeded": {
      "type": "boolean"
    },
    "error_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^ARENA-[A-Z0-9-]+$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "passed",
          "detail"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "passed": {
            "type": "boolean"
          },
          "error_code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^ARENA-[A-Z0-9-]+$"
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
