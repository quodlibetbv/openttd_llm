{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/runs/run-lifecycle-event.v1.json",
  "title": "OpenTTD Model Arena run lifecycle event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "occurred_utc",
    "state"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,95}$"
    },
    "occurred_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "state": {
      "type": "string",
      "enum": [
        "created",
        "preparing",
        "starting_server",
        "waiting_for_game_script",
        "starting_clients",
        "ready",
        "running",
        "finalizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "preparation_failed",
        "startup_timed_out",
        "game_script_not_ready",
        "server_exited",
        "spectator_exited",
        "finalization_failed"
      ]
    },
    "error_code": {
      "type": "string",
      "pattern": "^ARENA-[A-Z0-9-]+$"
    },
    "detail": {
      "type": "string",
      "maxLength": 512
    }
  }
}
