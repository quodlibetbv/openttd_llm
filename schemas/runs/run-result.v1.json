{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/runs/run-result.v1.json",
  "title": "OpenTTD Model Arena run result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "completed_utc",
    "final_state",
    "exit_reason",
    "components",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,95}$"
    },
    "created_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "completed_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 40
    },
    "final_state": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled"]
    },
    "exit_reason": {
      "type": "string",
      "enum": [
        "completed",
        "cancelled",
        "preparation_failed",
        "startup_timed_out",
        "game_script_not_ready",
        "server_exited",
        "spectator_exited",
        "finalization_failed"
      ]
    },
    "error_code": {
      "type": "string",
      "pattern": "^ARENA-[A-Z0-9-]+$"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_id", "process_id"],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "process_id": {
            "type": "integer",
            "minimum": 1
          },
          "stable_window_title": {
            "type": "string",
            "maxLength": 160
          },
          "exit_code": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]{0,239}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
