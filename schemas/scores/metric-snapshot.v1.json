{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/scores/metric-snapshot.v1.json",
  "title": "Authoritative benchmark metric snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sample_id", "kind", "source", "game_date", "game_tick", "metrics"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "sample_id": { "$ref": "#/$defs/identifier" },
    "kind": { "type": "string", "enum": ["initial", "periodic", "final"] },
    "source": { "const": "gamescript" },
    "game_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "game_tick": { "type": "integer", "minimum": 0 },
    "metrics": { "$ref": "#/$defs/metrics" }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cash", "loan", "quarterly_income", "quarterly_expenses", "operating_profit", "company_value", "quarterly_cargo_delivered", "active_vehicle_count", "operational_route_count", "completed_project_count", "infrastructure_investment", "invalid_decision_count", "constraint_violation_count"],
      "properties": {
        "cash": { "type": "integer" },
        "loan": { "type": "integer", "minimum": 0 },
        "quarterly_income": { "type": "integer" },
        "quarterly_expenses": { "type": "integer" },
        "operating_profit": { "type": "integer" },
        "company_value": { "type": "integer" },
        "quarterly_cargo_delivered": { "type": "integer", "minimum": 0 },
        "active_vehicle_count": { "type": "integer", "minimum": 0 },
        "operational_route_count": { "type": "integer", "minimum": 0 },
        "completed_project_count": { "type": "integer", "minimum": 0 },
        "infrastructure_investment": { "type": "integer", "minimum": 0 },
        "invalid_decision_count": { "type": "integer", "minimum": 0 },
        "constraint_violation_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
