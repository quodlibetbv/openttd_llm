{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/actions/action-request.v1.json",
  "title": "GameScript action request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "run_id",
    "decision_id",
    "correlation_id",
    "idempotency_key",
    "tool",
    "arguments"
  ],
  "properties": {
    "action_id": { "$ref": "#/$defs/identifier" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "decision_id": { "$ref": "#/$defs/identifier" },
    "correlation_id": { "$ref": "#/$defs/identifier" },
    "idempotency_key": { "$ref": "#/$defs/identifier" },
    "tool": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "arguments": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": true
    },
    "constraint_context": { "$ref": "#/$defs/constraint_context" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "constraint_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "scenario_version", "scenario_sha256", "minimum_cash_reserve", "per_project_budget", "maximum_active_projects", "allowed_modes", "allowed_cargo", "allowed_tools"],
      "properties": {
        "scenario_id": { "$ref": "#/$defs/identifier" },
        "scenario_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "scenario_sha256": { "$ref": "#/$defs/sha256" },
        "minimum_cash_reserve": { "type": "integer", "minimum": 0 },
        "per_project_budget": { "type": "integer", "minimum": 1 },
        "maximum_active_projects": { "type": "integer", "minimum": 1, "maximum": 16 },
        "allowed_modes": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "allowed_cargo": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "allowed_tools": { "type": "array", "minItems": 1, "maxItems": 11, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } }
      }
    }
  }
}
