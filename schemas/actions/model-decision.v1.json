{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/actions/model-decision.v1.json",
  "title": "Model decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "public_summary",
    "observations",
    "actions",
    "next_review_game_days"
  ],
  "properties": {
    "decision_id": {
      "$ref": "#/$defs/identifier"
    },
    "public_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/model_action"
      }
    },
    "next_review_game_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "model_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "arguments"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": true
        }
      }
    }
  }
}
