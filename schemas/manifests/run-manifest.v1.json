{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/manifests/run-manifest.v1.json",
  "title": "Immutable run manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_utc",
    "application_version",
    "git_commit",
    "provider",
    "model",
    "scenario_id",
    "scenario_version",
    "contract_versions",
    "benchmark_input_hashes",
    "artifact_hashes"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?(?:Z|[+-]00:00)$"
    },
    "application_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "scenario_id": { "$ref": "#/$defs/identifier" },
    "scenario_version": { "$ref": "#/$defs/semantic_version" },
    "contract_versions": { "$ref": "#/$defs/contract_versions" },
    "benchmark_input_hashes": { "$ref": "#/$defs/benchmark_input_hashes" },
    "artifact_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/artifact_hash" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "artifact_hash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_length"],
      "properties": {
        "relative_path": { "type": "string", "minLength": 1, "maxLength": 260, "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "type": "integer", "minimum": 0 }
      }
    },
    "contract_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "observation",
        "action",
        "goal",
        "score",
        "manifest"
      ],
      "properties": {
        "protocol": { "$ref": "#/$defs/version" },
        "observation": { "$ref": "#/$defs/version" },
        "action": { "$ref": "#/$defs/version" },
        "goal": { "$ref": "#/$defs/version" },
        "score": { "$ref": "#/$defs/version" },
        "manifest": { "$ref": "#/$defs/version" }
      }
    },
    "benchmark_input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starting_save_sha256",
        "content_manifest_sha256",
        "scenario_sha256",
        "scenario_schema_sha256",
        "game_settings_sha256",
        "prompt_template_sha256",
        "tool_contract_sha256",
        "observation_schema_sha256",
        "action_schema_sha256",
        "score_schema_sha256",
        "protocol_schema_sha256",
        "retry_policy_sha256",
        "end_condition_sha256"
      ],
      "properties": {
        "starting_save_sha256": { "$ref": "#/$defs/sha256" },
        "content_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "scenario_sha256": { "$ref": "#/$defs/sha256" },
        "scenario_schema_sha256": { "$ref": "#/$defs/sha256" },
        "game_settings_sha256": { "$ref": "#/$defs/sha256" },
        "prompt_template_sha256": { "$ref": "#/$defs/sha256" },
        "tool_contract_sha256": { "$ref": "#/$defs/sha256" },
        "observation_schema_sha256": { "$ref": "#/$defs/sha256" },
        "action_schema_sha256": { "$ref": "#/$defs/sha256" },
        "score_schema_sha256": { "$ref": "#/$defs/sha256" },
        "protocol_schema_sha256": { "$ref": "#/$defs/sha256" },
        "retry_policy_sha256": { "$ref": "#/$defs/sha256" },
        "end_condition_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
