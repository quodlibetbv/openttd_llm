{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/observations/gamescript-snapshot.v1.json",
  "title": "ArenaGS authoritative snapshot v1",
  "description": "Bounded game-side source state returned by ArenaGS before orchestrator reduction.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "game_date", "paused", "game_tick", "company", "towns", "industries", "stations", "vehicles", "routes", "projects", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "game_date": { "$ref": "#/$defs/date" },
    "paused": { "type": "boolean" },
    "game_tick": { "type": "integer", "minimum": 0 },
    "company": { "$ref": "#/$defs/company" },
    "towns": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/town" } },
    "industries": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/industry" } },
    "stations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/station" } },
    "vehicles": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/vehicle" } },
    "routes": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/route" } },
    "projects": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/project" } },
    "events": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
    "coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": { "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 } }
    },
    "company": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "name", "cash", "loan", "quarterly_income", "quarterly_expenses", "quarterly_cargo_delivered", "company_value", "performance_rating"],
      "properties": {
        "company_id": { "type": "integer", "minimum": 0 },
        "name": { "$ref": "#/$defs/name" },
        "cash": { "type": "integer" },
        "loan": { "type": "integer", "minimum": 0 },
        "quarterly_income": { "type": "integer" },
        "quarterly_expenses": { "type": "integer" },
        "quarterly_cargo_delivered": { "type": "integer", "minimum": 0 },
        "company_value": { "type": "integer" },
        "performance_rating": { "type": "integer", "minimum": 0 }
      }
    },
    "town": {
      "type": "object",
      "additionalProperties": false,
      "required": ["town_id", "name", "population", "location"],
      "properties": { "town_id": { "type": "integer", "minimum": 0 }, "name": { "$ref": "#/$defs/name" }, "population": { "type": "integer", "minimum": 0 }, "location": { "$ref": "#/$defs/coordinate" } }
    },
    "industry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industry_id", "name", "location"],
      "properties": { "industry_id": { "type": "integer", "minimum": 0 }, "name": { "$ref": "#/$defs/name" }, "location": { "$ref": "#/$defs/coordinate" } }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": ["station_id", "name", "location", "vehicle_count"],
      "properties": { "station_id": { "type": "integer", "minimum": 0 }, "name": { "$ref": "#/$defs/name" }, "location": { "$ref": "#/$defs/coordinate" }, "vehicle_count": { "type": "integer", "minimum": 0 } }
    },
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicle_id", "name", "vehicle_type", "state", "profit_last_year", "location"],
      "properties": {
        "vehicle_id": { "type": "integer", "minimum": 0 },
        "name": { "$ref": "#/$defs/name" },
        "vehicle_type": { "type": "string", "enum": ["road", "rail", "water", "air"] },
        "state": { "type": "string", "enum": ["running", "stopped", "in_depot", "at_station", "broken", "crashed"] },
        "profit_last_year": { "type": "integer" },
        "location": { "$ref": "#/$defs/coordinate" }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "action_id", "source_station_id", "destination_station_id", "cargo", "vehicle_ids", "operational"],
      "properties": {
        "route_id": { "$ref": "#/$defs/identifier" },
        "action_id": { "$ref": "#/$defs/identifier" },
        "source_station_id": { "type": "integer", "minimum": 0 },
        "destination_station_id": { "type": "integer", "minimum": 0 },
        "cargo": { "type": "string", "minLength": 1, "maxLength": 64 },
        "vehicle_ids": { "type": "array", "maxItems": 16, "items": { "type": "integer", "minimum": 0 } },
        "operational": { "type": "boolean" }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "action_id", "state", "spent", "maximum_budget"],
      "properties": {
        "project_id": { "$ref": "#/$defs/identifier" },
        "action_id": { "$ref": "#/$defs/identifier" },
        "state": { "type": "string", "enum": ["proposed", "validating", "surveying", "building_infrastructure", "buying_vehicles", "configuring_orders", "verifying", "adjusting_fleet", "completed", "recovering", "failed"] },
        "spent": { "type": "integer", "minimum": 0 },
        "maximum_budget": { "type": "integer", "minimum": 1 },
        "failure_code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^ARENA-[A-Z0-9-]+$" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "event_code", "game_date", "entity_ids", "public_summary"],
      "properties": {
        "event_id": { "$ref": "#/$defs/identifier" },
        "event_code": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^ARENA-[A-Z0-9-]+$" },
        "game_date": { "$ref": "#/$defs/date" },
        "entity_ids": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/identifier" } },
        "public_summary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001F\\u007F]*$" },
        "correlation_id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
