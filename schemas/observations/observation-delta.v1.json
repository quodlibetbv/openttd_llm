{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/observations/observation-delta.v1.json",
  "title": "Arena normalized observation delta v1",
  "description": "Bounded, hash-linked public observation changes between two canonical observation.v1 snapshots.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "from_observation_sha256", "to_observation_sha256", "operations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "$ref": "#/$defs/identifier" },
    "from_observation_sha256": { "$ref": "#/$defs/sha256" },
    "to_observation_sha256": { "$ref": "#/$defs/sha256" },
    "operations": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "path"],
      "properties": {
        "op": { "type": "string", "enum": ["set", "remove"] },
        "path": {
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "pattern": "^/.*$"
        },
        "value": {}
      }
    }
  }
}
