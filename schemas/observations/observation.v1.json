{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openttd-model-arena.dev/schemas/observations/observation.v1.json",
  "title": "Arena normalized observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "game_date",
    "sections"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "game_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sections": {
      "$ref": "#/$defs/sections"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "entity_ids": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_context",
        "goal_context",
        "game_clock",
        "company_summary",
        "financial_summary",
        "network_summary",
        "active_projects",
        "constraints_and_budgets",
        "candidate_opportunities",
        "recent_events",
        "prior_decision_results",
        "remaining_model_budget"
      ],
      "properties": {
        "run_context": { "$ref": "#/$defs/summary" },
        "goal_context": { "$ref": "#/$defs/summary" },
        "game_clock": { "$ref": "#/$defs/summary" },
        "company_summary": { "$ref": "#/$defs/summary" },
        "financial_summary": { "$ref": "#/$defs/summary" },
        "network_summary": { "$ref": "#/$defs/summary" },
        "active_projects": { "$ref": "#/$defs/summary" },
        "constraints_and_budgets": { "$ref": "#/$defs/summary" },
        "candidate_opportunities": { "$ref": "#/$defs/summary" },
        "recent_events": { "$ref": "#/$defs/summary" },
        "prior_decision_results": { "$ref": "#/$defs/summary" },
        "remaining_model_budget": { "$ref": "#/$defs/summary" }
      }
    }
  }
}
